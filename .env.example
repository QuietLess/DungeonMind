# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Your key from console.anthropic.com (starts with sk-ant-); empty = chat disabled
ANTHROPIC_API_KEY=
# claude (paid) or ollama (local, free)
DUNGEONMIND_PROVIDER=claude
# Optional per-step models, e.g. all=claude-haiku-5-5
DUNGEONMIND_MODELS=
